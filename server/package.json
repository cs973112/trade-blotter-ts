{
  "name": "@trade-blotter/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.1"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --disable-warning=ExperimentalWarning src/migrate.ts"
  },
  "dependencies": {
    "@fastify/swagger": "~9.9.2",
    "@fastify/swagger-ui": "~6.1.2",
    "@fastify/type-provider-typebox": "~6.3.0",
    "decimal.js": "~10.6.0",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "~5.12.7",
    "secure-json-parse": "~4.1.1",
    "typebox": "~1.4.3"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "~2.11.0",
    "drizzle-kit": "1.0.0-rc.5",
    "vitest": "~5.0.5"
  }
}
