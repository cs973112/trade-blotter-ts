    {
      "value": "\"audit_action\" in ('Inserted', 'Updated', 'Deleted')",
      "name": "trade_audit_action",
      "entityType": "checks",
      "table": "trade_audit"
    },
    {
      "value": "typeof(\"audit_on\") = 'text'\n    and \"audit_on\" glob '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9].[0-9][0-9][0-9]Z'",
      "name": "trade_audit_on",
      "entityType": "checks",
      "table": "trade_audit"
    },
    {
      "value": "\"audit_by\" = 'System'",
      "name": "trade_audit_by",
      "entityType": "checks",
      "table": "trade_audit"
    },
    {
      "value": "typeof(\"id\") = 'text' and length(\"id\") > 0",
      "name": "trades_id",
      "entityType": "checks",
      "table": "trades"
    },
    {
      "value": "typeof(\"symbol\") = 'text'\n      and length(\"symbol\") between 1 and 255\n      and \"symbol\" = trim(\"symbol\")",
      "name": "trades_symbol",
      "entityType": "checks",
      "table": "trades"
    },
    {
      "value": "\"side\" in ('Buy', 'Sell')",
      "name": "trades_side",
      "entityType": "checks",
      "table": "trades"
    },
    {
      "value": "typeof(\"quantity\") = 'text'\n    and (\"quantity\" glob '[0-9]' or \"quantity\" glob '[0-9]*[0-9]')\n    and \"quantity\" not glob '*[^0-9.]*'\n    and \"quantity\" not glob '*.*.*'\n    and \"quantity\" not glob '0[0-9]*'\n    and not (\"quantity\" glob '*.*' and \"quantity\" glob '*0')\n    and \"quantity\" <> '0'",
      "name": "trades_quantity",
      "entityType": "checks",
      "table": "trades"
    },
    {
      "value": "typeof(\"price\") = 'text'\n    and (\"price\" glob '[0-9]' or \"price\" glob '[0-9]*[0-9]')\n    and \"price\" not glob '*[^0-9.]*'\n    and \"price\" not glob '*.*.*'\n    and \"price\" not glob '0[0-9]*'\n    and not (\"price\" glob '*.*' and \"price\" glob '*0')\n    and \"price\" <> '0'",
      "name": "trades_price",
      "entityType": "checks",
      "table": "trades"
    },
    {
      "value": "(\"status\" = 'Executed' and typeof(\"executed_at\") = 'text'\n    and \"executed_at\" glob '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9].[0-9][0-9][0-9]Z')\n      or (\"status\" <> 'Executed' and \"executed_at\" is null)",
      "name": "trades_executed_at",
      "entityType": "checks",
      "table": "trades"
    },
    {
      "value": "typeof(\"status\") = 'text' and \"status\" in ('Pending', 'Executed', 'Cancelled')",
      "name": "trades_status",
      "entityType": "checks",
      "table": "trades"
    },
    {
      "value": "\"created_by\" in ('User', 'Admin') and \"updated_by\" in ('User', 'Admin')",
      "name": "trades_actors",
      "entityType": "checks",
      "table": "trades"
    },
    {
      "value": "(\"original_trade_id\" is null and \"cancellation_reason\" is null and \"created_by\" = 'User')\n      or (typeof(\"original_trade_id\") = 'text' and \"original_trade_id\" <> \"id\" and \"status\" = 'Cancelled'\n        and typeof(\"cancellation_reason\") = 'text' and length(trim(\"cancellation_reason\")) > 0\n        and length(\"cancellation_reason\") <= 500\n        and \"created_by\" = 'Admin' and \"updated_by\" = 'Admin' and \"created_at\" = \"updated_at\")",
      "name": "trades_cancellation",
      "entityType": "checks",
      "table": "trades"
    },
    {
      "value": "typeof(\"created_at\") = 'text'\n    and \"created_at\" glob '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9].[0-9][0-9][0-9]Z'",
      "name": "trades_created_at",
      "entityType": "checks",
      "table": "trades"
    },
    {
      "value": "typeof(\"updated_at\") = 'text'\n    and \"updated_at\" glob '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9].[0-9][0-9][0-9]Z' and \"updated_at\" >= \"created_at\"",
      "name": "trades_updated_at",
      "entityType": "checks",
      "table": "trades"
    }
  ],
