{
  "name": "trade-blotter-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Trade blotter: book trades and derive positions. Node.js, TypeScript, Fastify and SQLite API with a Vue 3 frontend.",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": "^22.23.1"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/node": "~22.20.5",
    "eslint": "~10.14.0",
    "eslint-plugin-vue": "~10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vue-eslint-parser": "~10.4.1"
  }
}
