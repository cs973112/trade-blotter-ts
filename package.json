{
  "name": "trade-blotter-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Trade blotter: book trades and derive positions. Node.js, TypeScript, Fastify and SQLite API with a Vue 3 frontend.",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": "^22.23.1"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test",
    "app:start": "node --disable-warning=ExperimentalWarning server/scripts/app.ts start",
    "app:stop": "node --disable-warning=ExperimentalWarning server/scripts/app.ts stop",
    "app:status": "node --disable-warning=ExperimentalWarning server/scripts/app.ts status",
    "db:seed": "node --disable-warning=ExperimentalWarning server/scripts/trade-data.ts seed",
    "db:clear": "node --disable-warning=ExperimentalWarning server/scripts/trade-data.ts clear",
    "perf:api": "node --disable-warning=ExperimentalWarning server/scripts/perf-api.ts",
    "perf:api:sizes": "node --disable-warning=ExperimentalWarning server/scripts/perf-sizes.ts api",
    "perf:ui": "node --disable-warning=ExperimentalWarning server/scripts/perf-ui.ts",
    "perf:ui:sizes": "node --disable-warning=ExperimentalWarning server/scripts/perf-sizes.ts ui"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/node": "~22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vue-eslint-parser": "~10.4.1"
  }
}
